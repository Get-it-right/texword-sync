<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="en-US">
  <info><title>TexWord numeric bibliography</title><id>https://example.invalid/texword-numeric</id><updated>2026-10-20T00:00:00+00:00</updated></info>
  <citation><layout prefix="[" suffix="]" delimiter=", "><text variable="citation-number"/></layout></citation>
  <bibliography><layout suffix=".">
    <names variable="author" suffix=". "><name initialize-with=". " name-as-sort-order="all" sort-separator=", "/><substitute><text variable="editor"/></substitute></names>
    <text variable="title" suffix=". "/><text variable="container-title" font-style="italic" suffix=", "/>
    <date variable="issued" suffix=", "><date-part name="year"/></date>
    <text variable="volume"/><text variable="issue" prefix="(" suffix=")"/><text variable="page" prefix=": "/>
    <text variable="publisher" prefix=". "/><text variable="DOI" prefix=". DOI: "/>
  </layout></bibliography>
</style>
